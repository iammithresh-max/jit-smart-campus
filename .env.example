# =========================================================================
# JIT SMART CAMPUS - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env and configure with production credentials.
# NEVER commit production .env secrets to GitHub!
# =========================================================================

# Server Configuration
PORT=5500
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_256bit_secret_string

# Jansons Institute of Technology Merchant Configuration
# Requested Merchant UPI ID (Unverified until bank merchant onboarding is complete)
MERCHANT_UPI_ID=iammithresh@oksbi
MERCHANT_NAME="JIT Smart Campus Concessions"

# Payment Gateway Provider (Razorpay / Cashfree / Stripe / NPCI UPI Intent)
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_your_merchant_key_id
RAZORPAY_KEY_SECRET=your_merchant_secret_key_never_expose
GATEWAY_WEBHOOK_SECRET=whsec_your_webhook_signature_secret

# Persistent Database Configuration
# Supported: SQLite, PostgreSQL, MongoDB, or Local JSON Store
DATABASE_URL=file:./data/database.json

# PDF Document Upload Constraints
MAX_FILE_SIZE_MB=25
PDF_UPLOAD_DIR=./uploads
